<!DOCTYPE html>
<html>
<head>
    <title>Rahul Tourism & Hotels</title>
    <style>
        body {
            font-family: Arial;
            margin: 0;
            background-color: #f4f4f4;
        }
        header {
            background: #0d6efd;
            color: white;
            padding: 20px;
            text-align: center;
        }
        .hero {
            background-image: url('https://images.unsplash.com/photo-1501117716987-c8e1ecb2106e');
            background-size: cover;
            color: white;
            padding: 100px;
            text-align: center;
        }
        .container {
            padding: 40px;
            text-align: center;
        }
        .card {
            background: white;
            padding: 20px;
            margin: 20px;
            display: inline-block;
            width: 250px;
            box-shadow: 0 0 10px gray;
        }
        footer {
            background: #222;
            color: white;
            padding: 20px;
            text-align: center;
        }
        button {
            padding: 10px 20px;
            background: #0d6efd;
            color: white;
            border: none;
            cursor: pointer;
        }
    </style>
</head>
<body>

<header>
    <h1>Welcome to Rahul Tourism</h1>
    <p>Your Dream Vacation Starts Here</p>
</header>

<div class="hero">
    <h2>Explore Beautiful Destinations</h2>
    <p>Book Hotels | Flights | Packages</p>
    <button>Book Now</button>
</div>

<div class="container">
    <div class="card">
        <h3>Goa Beach</h3>
        <p>Luxury Stay - ₹5999/night</p>
    </div>
    <div class="card">
        <h3>Manali Hills</h3>
        <p>Mountain Resort - ₹6999/night</p>
    </div>
    <div class="card">
        <h3>Kerala Backwaters</h3>
        <p>Houseboat - ₹8999/night</p>
    </div>
</div>

<footer>
    <p>© 2026 Rahul Tourism. DevOps Project.</p>
</footer>

</body>
</html>